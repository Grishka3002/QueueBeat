PORT=4001
DATABASE_URL="postgresql://music:music@localhost:5433/music_library?schema=public"
API_KEY="dev-library-key"

STORAGE_DRIVER="s3"

S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="music-library"
S3_ACCESS_KEY_ID="minioadmin"
S3_SECRET_ACCESS_KEY="minioadmin"
S3_FORCE_PATH_STYLE="true"
SIGNED_URL_TTL_SECONDS=900

MAX_IMPORT_BYTES=104857600
IMPORT_USER_AGENT="QueueBeatMusicLibrary/0.1"
MAX_PROVIDER_TRACKS_PER_RUN="1000000"
MAX_PROVIDER_QUEUE_CHUNK="1000"
MAX_PROVIDER_PROCESS_BATCH="100"
MAX_PROVIDER_ITEM_ATTEMPTS="5"
