{
  "name": "queuebeat-music-library-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json && node scripts/copy-build-assets.mjs",
    "start": "node dist/server.js",
    "worker:providers": "tsx src/provider-worker.ts",
    "doctor": "powershell -ExecutionPolicy Bypass -File scripts/doctor.ps1",
    "use:docker": "powershell -ExecutionPolicy Bypass -File scripts/use-docker-stack.ps1",
    "use:local-postgres": "powershell -ExecutionPolicy Bypass -File scripts/use-local-postgres.ps1",
    "postgres:reset-admin-password": "powershell -ExecutionPolicy Bypass -File scripts/reset-postgres-admin-password.ps1",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:push": "prisma db push",
    "prisma:studio": "prisma studio"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.726.1",
    "@aws-sdk/s3-request-presigner": "^3.726.1",
    "@prisma/client": "^6.7.0",
    "fastify": "^5.2.1"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "prisma": "^6.7.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
