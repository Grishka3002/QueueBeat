generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  PLATFORM_ADMIN
  VENUE_OWNER
  ADMIN
}

enum VenueVerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
}

enum QueueItemStatus {
  QUEUED
  PLAYED
  REMOVED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String?
  role         UserRole @default(VENUE_OWNER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  venues       Venue[]
}

model Venue {
  id                  String      @id @default(cuid())
  ownerId             String?
  name                String
  slug                String      @unique
  requestPriceCents   Int
  isAcceptingRequests Boolean     @default(true)
  verificationStatus  VenueVerificationStatus @default(PENDING)
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
  owner               User?       @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  venueTracks         VenueTrack[]
  orders              Order[]
  queueItems          QueueItem[]

  @@index([ownerId])
}

model Track {
  id          String      @id @default(cuid())
  title       String
  artist      String
  durationSec Int
  coverUrl    String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  venueTracks VenueTrack[]
  orders      Order[]
  queueItems  QueueItem[]
}

model VenueTrack {
  id        String   @id @default(cuid())
  venueId   String
  trackId   String
  createdAt DateTime @default(now())
  venue      Venue   @relation(fields: [venueId], references: [id], onDelete: Cascade)
  track      Track   @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@unique([venueId, trackId])
}

model Order {
  id               String      @id @default(cuid())
  venueId          String
  trackId          String
  amountCents      Int
  status           OrderStatus @default(PENDING)
  paymentReference String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  paidAt           DateTime?
  venue            Venue       @relation(fields: [venueId], references: [id], onDelete: Cascade)
  track            Track       @relation(fields: [trackId], references: [id], onDelete: Restrict)
  queueItem        QueueItem?
}

model QueueItem {
  id          String          @id @default(cuid())
  venueId     String
  trackId     String
  orderId     String          @unique
  status      QueueItemStatus @default(QUEUED)
  position    Int
  createdAt   DateTime        @default(now())
  playedAt    DateTime?
  removedAt   DateTime?
  venue       Venue           @relation(fields: [venueId], references: [id], onDelete: Cascade)
  track       Track           @relation(fields: [trackId], references: [id], onDelete: Restrict)
  order       Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([venueId, status, position])
  @@unique([venueId, position])
}
