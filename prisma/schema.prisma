generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  PLATFORM_ADMIN
  VENUE_OWNER
  ADMIN
}

enum VenueVerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum BusinessType {
  INDIVIDUAL_ENTREPRENEUR
  LLC
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELED
}

enum PaymentKind {
  TRACK_REQUEST
  SUBSCRIPTION
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
}

enum LedgerEntryType {
  VENUE_SHARE
  PLATFORM_FEE
  PAYOUT
  ADJUSTMENT
}

enum PayoutStatus {
  PENDING
  PAID
  CANCELED
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
}

enum QueueItemStatus {
  QUEUED
  PLAYED
  REMOVED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String?
  role         UserRole @default(VENUE_OWNER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  venues       Venue[]
}

model Venue {
  id                  String      @id @default(cuid())
  ownerId             String?
  name                String
  slug                String      @unique
  requestPriceCents   Int
  isAcceptingRequests Boolean     @default(true)
  address             String      @default("")
  city                String      @default("")
  accentColor         String      @default("#F849A6")
  backgroundMode      Boolean     @default(true)
  tariff              String      @default("start")
  verificationStatus  VenueVerificationStatus @default(PENDING)
  platformFeeBps      Int         @default(2000)
  trialEndsAt          DateTime?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
  owner               User?       @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  businessProfile     BusinessProfile?
  subscriptions        VenueSubscription[]
  payments             Payment[]
  ledgerEntries        LedgerEntry[]
  payouts              Payout[]
  venueTracks         VenueTrack[]
  orders              Order[]
  queueItems          QueueItem[]

  @@index([ownerId])
}

model BusinessProfile {
  id              String       @id @default(cuid())
  venueId         String       @unique
  businessType    BusinessType
  legalName       String
  inn             String
  kpp             String?
  ogrn            String?
  ogrnip          String?
  legalAddress    String
  actualAddress   String?
  contactName     String
  contactPhone    String
  contactEmail    String
  bankName        String?
  bankBik         String?
  bankAccount     String?
  corrAccount     String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  venue           Venue        @relation(fields: [venueId], references: [id], onDelete: Cascade)
}

model Track {
  id               String      @id @default(cuid())
  title            String
  artist           String
  durationSec      Int
  coverUrl         String?
  genre            String      @default("pop")
  libraryTrackId   String?     @unique
  librarySyncedAt  DateTime?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  venueTracks      VenueTrack[]
  orders           Order[]
  queueItems       QueueItem[]
  presetTracks PlaylistPresetTrack[]
}

model SubscriptionPlan {
  id              String              @id @default(cuid())
  name            String
  slug            String              @unique
  priceCents      Int
  intervalMonths  Int                 @default(1)
  isActive        Boolean             @default(true)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  subscriptions   VenueSubscription[]
}

model VenueSubscription {
  id        String             @id @default(cuid())
  venueId   String
  planId    String
  status    SubscriptionStatus @default(TRIAL)
  startsAt  DateTime           @default(now())
  currentPeriodEnd DateTime
  canceledAt DateTime?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  venue     Venue              @relation(fields: [venueId], references: [id], onDelete: Cascade)
  plan      SubscriptionPlan   @relation(fields: [planId], references: [id], onDelete: Restrict)
  payments  Payment[]

  @@index([venueId, status, currentPeriodEnd])
}

model VenueTrack {
  id        String   @id @default(cuid())
  venueId   String
  trackId   String
  createdAt DateTime @default(now())
  venue      Venue   @relation(fields: [venueId], references: [id], onDelete: Cascade)
  track      Track   @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@unique([venueId, trackId])
}

model Order {
  id               String      @id @default(cuid())
  venueId          String
  trackId          String
  amountCents      Int
  status           OrderStatus @default(PENDING)
  paymentReference String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  paidAt           DateTime?
  venue            Venue       @relation(fields: [venueId], references: [id], onDelete: Cascade)
  track            Track       @relation(fields: [trackId], references: [id], onDelete: Restrict)
  queueItem        QueueItem?
  payments         Payment[]
  ledgerEntries    LedgerEntry[]
}

model Payment {
  id             String        @id @default(cuid())
  venueId        String
  orderId        String?
  subscriptionId String?
  kind           PaymentKind
  status         PaymentStatus @default(PENDING)
  amountCents    Int
  provider       String        @default("mock")
  providerRef    String?
  createdAt      DateTime      @default(now())
  paidAt         DateTime?
  venue          Venue         @relation(fields: [venueId], references: [id], onDelete: Cascade)
  order          Order?        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  subscription   VenueSubscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@index([venueId, status, createdAt])
  @@index([orderId])
}

model LedgerEntry {
  id          String          @id @default(cuid())
  venueId     String
  orderId     String?
  type        LedgerEntryType
  amountCents Int
  description String
  createdAt   DateTime        @default(now())
  venue       Venue           @relation(fields: [venueId], references: [id], onDelete: Cascade)
  order       Order?          @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([venueId, type, createdAt])
}

model Payout {
  id          String       @id @default(cuid())
  venueId     String
  amountCents Int
  status      PayoutStatus @default(PENDING)
  note        String?
  createdAt   DateTime     @default(now())
  paidAt      DateTime?
  venue       Venue        @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@index([venueId, status, createdAt])
}

model PlaylistPreset {
  id          String                @id @default(cuid())
  name        String
  slug        String                @unique
  description String
  createdAt   DateTime              @default(now())
  presetTracks PlaylistPresetTrack[]
}

model PlaylistPresetTrack {
  id        String         @id @default(cuid())
  presetId  String
  trackId   String
  position  Int
  preset    PlaylistPreset @relation(fields: [presetId], references: [id], onDelete: Cascade)
  track     Track          @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@unique([presetId, trackId])
  @@index([presetId, position])
}

model QueueItem {
  id          String          @id @default(cuid())
  venueId     String
  trackId     String
  orderId     String          @unique
  status      QueueItemStatus @default(QUEUED)
  position    Int
  createdAt   DateTime        @default(now())
  playedAt    DateTime?
  removedAt   DateTime?
  venue       Venue           @relation(fields: [venueId], references: [id], onDelete: Cascade)
  track       Track           @relation(fields: [trackId], references: [id], onDelete: Restrict)
  order       Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([venueId, status, position])
  @@unique([venueId, position])
}
